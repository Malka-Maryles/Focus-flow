# Copy this file to ".env" and fill in your values.
# DB_* settings are forced by docker-compose.yml, so they don't matter here.

# Used to generate quizzes/summaries when a video is added (required for that feature)
GEMINI_API_KEY=your_gemini_api_key_here
MODE=norm

# Only needed for sign-up confirmation emails (Gmail "App Password")
GMAIL_SENDER_EMAIL=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Optional: only set these if you really use a proxy for fetching YouTube transcripts. using it on local network would not require a proxy.
# Leave them out entirely otherwise - placeholder values will break transcript fetching.
# PROXY_HTTP=http://host:port
# PROXY_HTTPS=https://host:port
