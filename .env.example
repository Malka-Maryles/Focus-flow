# FocusFlow - Environment Variables Example Template
# Duplicate this file to '.env' and adjust values as needed.
# NEVER commit sensitive secrets or real credentials to Git!

# Frontend Configuration
PORT=3000
VITE_API_URL=http://localhost:8000

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# Database Configuration
# Inside Docker network: mongodb://mongodb:27017/focusflow
# Running locally outside Docker: mongodb://localhost:27017/focusflow
MONGODB_URL=mongodb://mongodb:27017/focusflow
MONGODB_DB_NAME=focusflow

# Security & JWT Configuration
# Generate a strong 32+ character random secret in production!
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Attention Model Configuration
# When set to true, uses explicitly labeled simulated results if ONNX model is not present.
ATTENTION_SIMULATION_MODE=true
ONNX_MODEL_PATH=./models/attention_model.onnx

# AI / External API Keys (Optional student placeholder)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_OPTIONAL_PLACEHOLDER
